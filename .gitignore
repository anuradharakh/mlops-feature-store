.pytype/

# ============================================================
# Jupyter and IPython
# ============================================================
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ============================================================
# IDE and editor files
# ============================================================
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject
tempCodeRunnerFile.py
*.swp
*.swo

# ============================================================
# Application logs and temporary files
# ============================================================
*.log
*.tmp
*.temp
*.bak

# ============================================================
# Raw and intermediate datasets
#
# The original source dataset is managed by DVC.
# Generated raw, processed, and training datasets are reproducible
# pipeline outputs and are not committed directly to Git.
# ============================================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

data/training/*
!data/training/.gitkeep

# ============================================================
# Feature artifacts
#
# Feature Version 1 and Version 2 Parquet files ARE committed so
# the TA can inspect evidence of feature versioning directly.
# Therefore, data/features is intentionally NOT ignored.
# ============================================================

# ============================================================
# Feast local/generated state
#
# Keep Python feature definitions and feature_store.yaml in Git.
# Ignore only generated registry and online-store files.
# ============================================================
feature_repo/registry.db
feature_repo/registry.db.*
feature_repo/online_store.db
feature_repo/online_store.db.*
feature_repo/data/
feature_repo/.feast/
feature_repo/.cache/

# ============================================================
# MLflow local state
#
# Curated experiment summaries, metrics, plots, and screenshots
# belong under reports/ and docs/ and ARE committed.
# ============================================================
mlflow.db
mlflow.db-shm
mlflow.db-wal
mlruns/
artifacts/mlflow/

# ============================================================
# Trained model binaries
#
# Do not commit every locally generated model. MLflow tracks them
# locally, while curated evaluation artifacts are committed.
# ============================================================
artifacts/models/*
!artifacts/models/.gitkeep

*.joblib
*.pkl
*.pickle

# ============================================================
# Documentation
#
# README, rollout Markdown, rollout HTML, and report assets ARE
# committed. Ignore only temporary documentation build output.
# ============================================================
docs/_build/
site/

# ============================================================
# Reports
#
# Validation reports, metrics, figures, and review artifacts ARE
# intentionally committed for grading.
# Therefore, reports/ is intentionally NOT ignored.
# ============================================================

# ============================================================
# Framework-specific local state
# ============================================================
instance/
.webassets-cache/
.scrapy/
.pybuilder/
target/
.abstra/
.pdm-python
.pdm-build/
.pixi/
__pypackages__/
cython_debug/
.streamlit/secrets.toml

# Celery
celerybeat-schedule
celerybeat.pid

# Redis
*.rdb
*.aof
*.pid

# RabbitMQ
mnesia/
rabbitmq/
rabbitmq-data/

# ActiveMQ
activemq-data/

# SageMath
*.sage.py

# PyPI local configuration
.pypirc

# Assignment 2 training artifacts committed for TA review
!data/training/
!data/training/athlete_training_v1.parquet
!data/training/athlete_training_v2.parquet

!data/splits/
!data/splits/athlete_split.parquet
